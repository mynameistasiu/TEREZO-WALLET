generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  phone      String? 
  password   String
  fullName   String?
  firstName  String?
  isAdmin    Boolean   @default(false)
  isMember   Boolean   @default(false)
  balance    Int       @default(0)
  pendingBalance Int @default(0)
  welcomeBonusClaimed Boolean @default(false)
  otpCode    String?
  otpExpires DateTime?
  referralCode String  @unique @default(uuid())
  referredBy Int?
  kycStatus  String    @default("unverified")
  createdAt  DateTime  @default(now())
  tasks      TaskSubmission[]
  transactions Transaction[]
  withdrawals Withdrawal[]
}

model Fund {
  id    Int    @id @default(autoincrement())
  name  String
  code  String @unique
  createdAt DateTime @default(now())
  transactions Transaction[]
}

model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  reward      Int
  link        String?
  fundCode    String
  verification String
  requiresApprovalBefore Task? @relation("TaskDependency", fields: [requiresApprovalBeforeId], references: [id])
  requiresApprovalBeforeId Int?
  createdAt   DateTime @default(now())
  submissions TaskSubmission[]
  dependentTasks Task[] @relation("TaskDependency")
}

model TaskSubmission {
  id Int @id @default(autoincrement())
  task Task @relation(fields: [taskId], references: [id])
  taskId Int
  user User @relation(fields: [userId], references: [id])
  userId Int
  proof String?
  status String @default("pending")
  rewardPaid Boolean @default(false)
  createdAt DateTime @default(now())
}

model Transaction {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id])
  userId Int
  fund Fund @relation(fields: [fundId], references: [id])
  fundId Int
  type String
  amount Int
  meta String?
  createdAt DateTime @default(now())
}

model MembershipCode {
  id Int @id @default(autoincrement())
  code String @unique
  isActive Boolean @default(true)
  uses Int @default(0)
  maxUses Int @default(1)
  createdAt DateTime @default(now())
}

model Withdrawal {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id])
  userId Int
  amount Int
  bankName String
  accountName String
  accountNumber String
  reason String?
  status String @default("pending")
  reference String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ManualPayment {
  id Int @id @default(autoincrement())
  userId Int
  amount Int
  reference String @unique
  status String @default("pending")
  paymentProof String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
